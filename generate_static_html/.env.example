# ─────────────────────────────────────────────
# Battery Info Static — AWS Configuration
# ─────────────────────────────────────────────
# Skopiuj ten plik jako .env i uzupełnij wartości.
# cp .env.example .env
#
# UWAGA: Nigdy nie commituj .env do repozytorium!
# ─────────────────────────────────────────────

# === WYMAGANE ===

# Region AWS (domyślnie eu-central-1 = Frankfurt)
AWS_REGION=eu-central-1

# Nazwa S3 bucketu (dostaniesz ją po `cdk deploy` w output BucketName)
# Zostaw puste przed pierwszym deploy — CDK wygeneruje unikalną nazwę.
BUCKET_NAME=

# CloudFront Distribution ID (dostaniesz po `cdk deploy` w output DistributionId)
DISTRIBUTION_ID=

# === OPCJONALNE (custom domain) ===

# Twoja domena do stron baterii (np. baterie.twojafirma.pl)
# DOMAIN_NAME=

# Route53 Hosted Zone ID dla Twojej domeny
# HOSTED_ZONE_ID=

# ARN certyfikatu SSL z ACM (MUSI być w us-east-1 dla CloudFront!)
# CERTIFICATE_ARN=

# === AWS Credentials ===
# Preferowana metoda: `aws configure` (AWS CLI profile)
# Alternatywnie możesz ustawić tutaj:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ACCOUNT_ID=
